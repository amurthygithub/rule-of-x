# Third-party raw data are not redistributed: their licences differ, and some (METR run-level data) carry none.
# Sources, versions and checksums: data/raw/README.md, data/raw/CHECKSUMS.sha256, notes/data_sources_part2.md.
data/raw/*
!data/raw/README.md
!data/raw/CHECKSUMS.sha256
# Exception: two O*NET 31.0 files (CC BY 4.0) that the engine reads for job-title matching.
!data/raw/onet_31_0/
data/raw/onet_31_0/*
!data/raw/onet_31_0/job_titles.csv
!data/raw/onet_31_0/occupation_data.csv

# Build outputs (rebuilt by code/make_arxiv.py and code/build_paper1.sh)
dist/
/paper.pdf
/paper.aux
/paper.bbl
/paper.blg
/paper.fdb_latexmk
/paper.fls
/paper.log
/paper.out
/build.log
paper1/*.log
build_logs/

# Python caches and vendored wheels (versions are pinned in requirements.txt)
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
notes/*.whl
