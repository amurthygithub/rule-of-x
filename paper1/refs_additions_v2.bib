@misc{gundlach2025price,
  author        = {Gundlach, Hans and Lynch, Jayson and Mertens, Matthias and Thompson, Neil},
  title         = {The Price of Progress: Price Performance and the Future of {AI}},
  year          = {2025},
  eprint        = {2511.23455},
  archivePrefix = {arXiv},
  primaryClass  = {cs.LG},
  note          = {arXiv:2511.23455, first submitted 28 November 2025, version 2 of 23 March 2026; preprint, not peer reviewed. Revision 2 note: the price of a fixed benchmark performance fell by about 5 to 10 times a year for models on the cost-performance Pareto frontier, April 2024 to November 2025 (Section 2.3; GPQA-Diamond 5.3, AIME 11.7, SWE-bench Verified 4.7 with a 90 percent interval of 0.68 to 32; all-model estimates are smaller). Separately, the cost of running the record-performance model on each benchmark rose by 3 to 18 times a year (Section 5), because token volume rises, not because per-token prices rise}
}

@techreport{bonney2024tracking,
  author      = {Bonney, Kathryn and Breaux, Cory and Buffington, Cathy and Dinlersoz, Emin and Foster, Lucia S. and Goldschlag, Nathan and Haltiwanger, John C. and Kroff, Zachary and Savage, Keith},
  title       = {Tracking Firm Use of {AI} in Real Time: A Snapshot from the {Business Trends and Outlook Survey}},
  institution = {National Bureau of Economic Research},
  type        = {NBER Working Paper},
  number      = {32319},
  year        = {2024},
  month       = apr,
  doi         = {10.3386/w32319},
  note        = {Revision 2 note: biweekly BTOS estimates for September 2023 to February 2024 rose from 3.7 to 5.4 percent of firms, with 6.6 percent expected by early fall 2024, under the question whether the business used AI in producing goods or services. The Census Bureau replaced that wording with a broader question from 17 November 2025; see census2025btoswording and allen2026monitoring before comparing with the 2026 series}
}

@techreport{bonney2026microstructure,
  author      = {Bonney, Kathryn and Breaux, Cory L. and Dinlersoz, Emin and Foster, Lucia S. and Haltiwanger, John C. and Pande, Aditya A.},
  title       = {The Microstructure of {AI} Diffusion: Evidence from Firms, Business Functions, and Worker Tasks},
  institution = {National Bureau of Economic Research},
  type        = {NBER Working Paper},
  number      = {35141},
  year        = {2026},
  month       = apr,
  doi         = {10.3386/w35141},
  note        = {Revision 2 note: 2026 AI supplement to the BTOS; during November 2025 to January 2026, 18 percent of firms (32 percent employment-weighted) used AI in at least one business function. The question was broadened on 17 November 2025 (use in any business function), so this level is not comparable with the 3.7 to 5.4 percent of bonney2024tracking. Among adopters 57 percent use AI in three or fewer functions, 66 percent of firms use AI for task augmentation and employment reductions are rare (2 percent). Regressions show a positive relationship between firm performance and integration breadth (an association, not an effect); functional deployment and operational investment are associated with employment declines. The earlier note on a Census CES working paper number was not confirmed and is dropped}
}

@article{terry2023macro,
  author  = {Terry, Stephen J.},
  title   = {The Macro Impact of Short-Termism},
  journal = {Econometrica},
  volume  = {91},
  number  = {5},
  pages   = {1881--1912},
  year    = {2023},
  doi     = {10.3982/ECTA15420},
  note    = {Revision 2 note: in the data, firms that just meet Wall Street forecasts have lower R\&D growth and subsequent innovation, and managers who just miss receive lower pay; an estimated endogenous growth model shows that short-termism slows growth. The article does not say that such firms cut R\&D spending}
}

@techreport{hampole2025artificial,
  author      = {Hampole, Menaka and Papanikolaou, Dimitris and Schmidt, Lawrence D. W. and Seegmiller, Bryan},
  title       = {Artificial Intelligence and the Labor Market},
  institution = {National Bureau of Economic Research},
  type        = {NBER Working Paper},
  number      = {33509},
  year        = {2025},
  month       = feb,
  doi         = {10.3386/w33509},
  note        = {Revision 2 note: revised September 2025. Firm AI adoption is measured by internally developed AI applications extracted from resumes (Revelio Labs), Compustat firms, 2014 to 2023, instrumented by a shift-share university-hiring instrument. Section 3.2, Table 4: a one standard deviation increase in AI adoption raises five-year firm revenue growth by 9.7 percentage points, total factor productivity growth by 7.5 points and employment by 6.8 points (IV); the abstract states only that labor demand rises at adopting firms}
}


