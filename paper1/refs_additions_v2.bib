@techreport{demirer2025emerging,
  author      = {Demirer, Mert and Fradkin, Andrey and Tadelis, Nadav and Peng, Sida},
  title       = {The Emerging Market for Intelligence: Pricing, Supply, and Demand for {LLMs}},
  institution = {National Bureau of Economic Research},
  type        = {NBER Working Paper},
  number      = {34608},
  year        = {2025},
  month       = dec,
  doi         = {10.3386/w34608},
  note        = {Preliminary. Revision 2 note: the elasticity of about -1.11 (standard error 0.22; 32,539 provider-model-day observations; Table 2, specification 3; Section 7.3) is a within-model elasticity across inference providers of the same open-weight model on OpenRouter, not a firm or market demand elasticity. The authors state that aggregate demand elasticities are substantially smaller, read the result as going against a short-run Jevons paradox at the market level, and say it does not preclude Jevons effects at longer horizons. Author version dated 12 December 2025}
}

